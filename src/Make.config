# -*- makefile -*-
# PintOS Build Configuration
# Uses GCC with -m32 on x86-64 systems for 32-bit x86 kernel compilation

SHELL = /bin/sh
VPATH = $(SRCDIR)

# ============================================================================
# Toolchain Selection (CC, LD, OBJCOPY)
# ============================================================================

MACHINE         = $(shell uname -m)
X86_64_PATTERN  = x86_64
X86_PATTERN     = i.86\|pentium.*\|[pk][56]\|nexgen\|viac3\|6x86\|athlon.*\|i86pc

ifneq ($(shell expr $(MACHINE) : '$(X86_64_PATTERN)'),0)
	# x86-64 host: use -m32 for 32-bit compilation
	CC      = gcc -m32
	LD      = ld -melf_i386
	OBJCOPY = objcopy
else ifneq ($(shell expr $(MACHINE) : '$(X86_PATTERN)'),0)
	# Native x86 host
	CC      = gcc
	LD      = ld
	OBJCOPY = objcopy
else
	# Cross-compilation
	CC      = i386-elf-gcc
	LD      = i386-elf-ld
	OBJCOPY = i386-elf-objcopy
endif

# ============================================================================
# Compilation Flags
# ============================================================================

DEFINES   =
WARNINGS  = -Wall -Wextra -Wstrict-prototypes -Wmissing-prototypes -Wsystem-headers
CFLAGS    = -ggdb3 -msoft-float -O1 -march=i686 -fno-stack-protector -fno-omit-frame-pointer
CPPFLAGS  = -nostdinc -I$(SRCDIR) -I$(SRCDIR)/lib
ASFLAGS   = -Wa,--gstabs
LDFLAGS   = -Wl,--build-id=none -z noseparate-code
DEPS      = -MMD -MF $(@:.o=.d)

# ============================================================================
# Build Rules
# ============================================================================

%.o: %.c
	$(CC) -c $< -o $@ $(CFLAGS) $(CPPFLAGS) $(WARNINGS) $(DEFINES) $(DEPS)

%.o: %.S
	$(CC) -c $< -o $@ $(ASFLAGS) $(CPPFLAGS) $(DEFINES) $(DEPS)
